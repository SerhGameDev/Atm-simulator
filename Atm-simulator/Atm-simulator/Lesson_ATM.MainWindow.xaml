<Window x:Class="Lesson_ATM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATM Simulator"
        Width="520"
        Height="700"
        Background="#1E1E1E"
        WindowStyle="ToolWindow">

    <Grid Margin="20">

        <!-- =========================================
             ДЕЛИМ ОКНО НА СТРОКИ
             ========================================= -->

        <Grid.RowDefinitions>

            <!-- 0. Название банка -->
            <RowDefinition Height="Auto"/>

            <!-- 1. Экран банкомата -->
            <RowDefinition Height="Auto"/>

            <!-- 2. Быстрый выбор суммы -->
            <RowDefinition Height="Auto"/>

            <!-- 3. Ввод своей суммы -->
            <RowDefinition Height="Auto"/>

            <!-- 4. Основные действия -->
            <RowDefinition Height="Auto"/>

            <!-- 5. Дополнительные кнопки -->
            <RowDefinition Height="Auto"/>

            <!-- 6. Свободное место -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =========================================
             ROW 0
             НАЗВАНИЕ
             ========================================= -->

        <TextBlock Grid.Row="0"
                   Text="MY BANK"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="10"/>


        <!-- =========================================
             ROW 1
             ЭКРАН БАНКОМАТА
             ========================================= -->

        <Border Grid.Row="1"
                Background="#2D2D2D"
                CornerRadius="10"
                Padding="20"
                Margin="5">

            <StackPanel>

                <!-- Подпись над балансом -->
                <TextBlock Text="Баланс"
                           FontSize="18"
                           Foreground="LightGray"
                           HorizontalAlignment="Center"/>

                <!--
                    Здесь показывается текущий баланс.

                    x:Name="BalanceText"
                    позволяет обращаться к этому элементу из C#.
                -->
                <TextBlock x:Name="BalanceText"
                           Text="5000 ₽"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="LightGreen"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,15"/>


                <!-- Подпись над сообщением -->
                <TextBlock Text="Сообщение"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>

                <!--
                    Здесь программа будет показывать сообщения.

                    Например:
                    "Вы сняли 500 ₽"
                    "Недостаточно денег"
                    "Введите число"
                -->
                <TextBlock x:Name="MessageText"
                           Text="Добро пожаловать!"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

            </StackPanel>

        </Border>


        <!-- =========================================
             ROW 2
             БЫСТРЫЙ ВЫБОР СУММЫ
             ========================================= -->

        <StackPanel Grid.Row="2"
                    Margin="5">

            <TextBlock Text="Выберите сумму"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="5"/>

            <Grid>

                <!-- =====================================
                     РАЗДЕЛЕНИЕ НА ТРИ СТОЛБЦА
                     ===================================== -->

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>


                <!-- =====================================
                     КНОПКА 100 ₽

                     Пока кнопка ничего не делает.
                     На занятии подключим её к C#.
                     ===================================== -->

                <Button Grid.Column="0"
                        Content="100 ₽"
                        Height="50"
                        FontSize="18"
                        Margin="5"/>


                <!-- =====================================
                     КНОПКА 500 ₽

                     Пока кнопка ничего не делает.
                     ===================================== -->

                <Button Grid.Column="1"
                        Content="500 ₽"
                        Height="50"
                        FontSize="18"
                        Margin="5"/>


                <!-- =====================================
                     КНОПКА 1000 ₽

                     Пока кнопка ничего не делает.
                     ===================================== -->

                <Button Grid.Column="2"
                        Content="1000 ₽"
                        Height="50"
                        FontSize="18"
                        Margin="5"/>

            </Grid>

        </StackPanel>


        <!-- =========================================
             ROW 3
             СВОЯ СУММА
             ========================================= -->

        <StackPanel Grid.Row="3"
                    Margin="5">

            <TextBlock Text="Или введите свою сумму"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="5"/>

            <!--
                Пользователь сможет ввести сюда
                свою сумму.

                x:Name нужен, чтобы прочитать
                этот текст из C#.
            -->
            <TextBox x:Name="AmountTextBox"
                     Height="40"
                     FontSize="20"
                     Text="500"
                     HorizontalContentAlignment="Center"
                     Margin="5"/>

        </StackPanel>


        <!-- =========================================
             ROW 4
             ОСНОВНЫЕ ДЕЙСТВИЯ
             ========================================= -->

        <Grid Grid.Row="4"
              Margin="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <!-- =====================================
                 КНОПКА "ПОПОЛНИТЬ"

                 Позже подключим метод Deposit_Click.
                 ===================================== -->

            <Button x:Name="DepositButton"
                    Grid.Column="0"
                    Content="Пополнить"
                    Height="55"
                    FontSize="20"
                    Background="LightGreen"
                    Margin="5"/>


            <!-- =====================================
                 КНОПКА "СНЯТЬ"

                 Позже подключим метод Withdraw_Click.
                 ===================================== -->

            <Button x:Name="WithdrawButton"
                    Grid.Column="1"
                    Content="Снять"
                    Height="55"
                    FontSize="20"
                    Background="LightCoral"
                    Margin="5"/>

        </Grid>


        <!-- =========================================
             ROW 5
             ДОПОЛНИТЕЛЬНЫЕ ДЕЙСТВИЯ
             ========================================= -->

        <Grid Grid.Row="5"
              Margin="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <!-- =====================================
                 КНОПКА "ПОКАЗАТЬ БАЛАНС"

                 Позже подключим метод Balance_Click.
                 ===================================== -->

            <Button x:Name="BalanceButton"
                    Grid.Column="0"
                    Content="Показать баланс"
                    Height="45"
                    FontSize="16"
                    Margin="5"/>


            <!-- =====================================
                 КНОПКА "ЗАВЕРШИТЬ"

                 Позже подключим метод Exit_Click.
                 ===================================== -->

            <Button x:Name="ExitButton"
                    Grid.Column="1"
                    Content="Завершить"
                    Height="45"
                    FontSize="16"
                    Margin="5"/>

        </Grid>

    </Grid>

</Window>